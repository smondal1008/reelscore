rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Catalogue: anyone can read, only admins can change.
    match /movies/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /people/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // News stories: anyone can read published ones; drafts are for admins only. Only admins write.
    match /news/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // One verdicts doc and one reviews doc per person. Public to read, only the owner writes.
    match /verdicts/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) && request.resource.data.size() <= 3;
    }
    match /reviews/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) && request.resource.data.size() <= 3;
    }

    // Public name + avatar so friends can find and follow each other.
    match /users/{uid} {
      allow read: if true;
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'avatarUrl', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80;
    }

    // Private: My List, follows and release reminders.
    match /data/users/{uid}/{doc} {
      allow read, write: if isOwner(uid);
    }

    // Contact form: anyone can send a message (fixed fields and sizes); only admins can read, mark done or delete.
    match /contact/{id} {
      allow create: if request.resource.data.keys().hasOnly(['topic', 'name', 'email', 'message', 'page', 'at', 'uid'])
        && request.resource.data.topic in ['correction', 'add', 'takedown', 'privacy', 'partner', 'other']
        && request.resource.data.email is string && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 120
        && request.resource.data.message is string && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 2000
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.page is string && request.resource.data.page.size() <= 300
        && request.resource.data.at is string && request.resource.data.at.size() <= 40
        && (!('uid' in request.resource.data) || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read, update, delete: if isAdmin();
    }

    // Cloudinary upload settings: only admins can read. You create this doc in the console.
    match /private/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin list. Add admins from the Firebase console. Nobody can write here from the site.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
